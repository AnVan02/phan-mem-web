RewriteEngine On

# Hiển thị trang lỗi thân thiện khi URL không tồn tại.
ErrorDocument 404 /VietSon-Achieva/404.php

# Chuyển hướng robots.txt và sitemap.xml sang file PHP động
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Trang tĩnh: /ten-trang -> ten-trang.php nếu file đó tồn tại
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+)$ $1.php [L]

# Pretty URL cho chi tiết sản phẩm (dạng có tiền tố): /chi-tiet-san-pham/ten-san-pham -> chi-tiet-san-pham.php?ten-san-pham=ten-san-pham
RewriteRule ^chi-tiet-san-pham/([a-zA-Z0-9-]+)$ chi-tiet-san-pham.php?ten-san-pham=$1 [L,QSA]

# Pretty URL cho chi tiết sản phẩm: /ten-san-pham -> chi-tiet-san-pham.php?ten-san-pham=ten-san-pham (không lộ id)
# Chỉ áp dụng khi không trùng thư mục/tệp thật (vd: /admin, /assets...) để tránh chặn nhầm
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-zA-Z0-9-]+)$ chi-tiet-san-pham.php?ten-san-pham=$1 [L,QSA]

